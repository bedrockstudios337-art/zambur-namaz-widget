<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="#17252A">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ZAMBUR NAMAZ  •  BAKI" android:textColor="#F4D58D" android:textStyle="bold" android:textSize="14sp" />
    <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Namaz vaxtları" android:textColor="#D9E2E5" android:textSize="11sp" android:paddingTop="3dp" android:paddingBottom="8dp" />
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="2">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="5dp">
            <TextView android:text="Sübh" android:textColor="#AFC2C8" android:textSize="11sp" />
            <TextView android:id="@+id/fajr" android:text="--:--" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="5dp">
            <TextView android:text="Günəş" android:textColor="#AFC2C8" android:textSize="11sp" />
            <TextView android:id="@+id/sunrise" android:text="--:--" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="5dp">
            <TextView android:text="Zöhr" android:textColor="#AFC2C8" android:textSize="11sp" />
            <TextView android:id="@+id/dhuhr" android:text="--:--" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="5dp">
            <TextView android:text="Əsr" android:textColor="#AFC2C8" android:textSize="11sp" />
            <TextView android:id="@+id/asr" android:text="--:--" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="5dp">
            <TextView android:text="Məğrib" android:textColor="#AFC2C8" android:textSize="11sp" />
            <TextView android:id="@+id/maghrib" android:text="--:--" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="5dp">
            <TextView android:text="İşa" android:textColor="#AFC2C8" android:textSize="11sp" />
            <TextView android:id="@+id/isha" android:text="--:--" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
        </LinearLayout>
    </GridLayout>
    <TextView android:id="@+id/next_prayer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Növbəti namaz: --" android:textColor="#F4D58D" android:textStyle="bold" android:textSize="13sp" android:paddingTop="8dp" />
    <TextView android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Qalan vaxt: --" android:textColor="#FFFFFF" android:textSize="12sp" />
</LinearLayout>
